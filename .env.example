# ─────────────────────────────────────────────────────────────
# LLM providers
# ─────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for cloud Gemini generation and live voice.
# Without it the app still runs, but every reply is written by the deterministic
# template and the UI labels it "Deterministic template (no model billed)".
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model IDs are deployment data, not source constants — Google rotates preview IDs.
# Override here if a default ID 404s; no code change or redeploy needed.
GEMINI_MODEL_FLASH_LITE="gemini-3.5-flash-lite"
GEMINI_MODEL_FLASH="gemini-3.8-flash"
GEMINI_MODEL_LIVE="gemini-3.8-live"

# Preview tiers answer throttling 503s ("high demand, retry with exponential backoff").
# Generation retries with 0.8s -> 1.6s -> 3.2s (capped at 12s) before the run falls back to
# the deterministic template and says so in the UI. Lower it to fail fast, raise it under load.
GEMINI_MAX_ATTEMPTS="4"
GEMINI_REQUEST_TIMEOUT_MS="25000"
GEMINI_GTM_MAX_ATTEMPTS="1"
GEMINI_GTM_TIMEOUT_MS="12000"

# A quota 429 ("You exceeded your current quota") is permanent for that model and is what a
# free-tier key usually hits on gemini-3.8-flash first. When that happens the agent regenerates
# on GEMINI_MODEL_FLASH_LITE and bills it as that tier, because "use the smallest model that
# answers" is the point of the project. Set GEMINI_QUOTA_FALLBACK="" to disable the degrade.
GEMINI_QUOTA_FALLBACK="1"

# Local zero-cost inference tier. The container in docker-compose.yml serves this.
# Leave OLLAMA_BASE_URL unset to skip cloud billing entirely on bulk runs.
#
# The host-run value (npm run dev) and the container value are NOT the same URL: 127.0.0.1
# inside a container is that container, not your machine. docker-compose.yml therefore reads
# CONTAINER_OLLAMA_BASE_URL / CONTAINER_N8N_WEBHOOK_URL and falls back to the service names
# (http://ollama:11434, http://n8n:5678). Set the CONTAINER_* pair only when the container must
# reach something that lives on the host, e.g. an Ollama you already installed locally:
#   CONTAINER_OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
# CONTAINER_OLLAMA_BASE_URL="http://ollama:11434"

# Reuse an Ollama store that already has the model instead of pulling a second ~2 GB copy
# into the `ollama_data` volume (a full disk refuses the pull outright). Only the immutable
# blobs/manifests are shared, read-only; the container keeps its own database alongside them.
# Find yours with: ollama show llama3.2:3b --path  (Linux host installs use the path below)
# OLLAMA_HOST_MODELS_DIR="/usr/share/ollama/.ollama/models"

# Ceiling for one local generation. Ollama loads the model into RAM on the first call
# after idle, and a CPU laptop can take 60-120s for a full GTM generation, so the default
# is generous. Lower it on a machine with a GPU; raise it if a bulk run gets interrupted.
OLLAMA_TIMEOUT_MS="120000"

# ─────────────────────────────────────────────────────────────
# n8n automation (the real handoff — leads are POSTed here)
# ─────────────────────────────────────────────────────────────

# Create an n8n workflow with a "Webhook" trigger (POST, path: growpilot-lead),
# then point this at it. Events sent: lead.qualified and gtm.lead_generated.
# Empty = automation disabled; the UI then reports "N8N_WEBHOOK_URL NOT CONFIGURED".
#
# For the stack in docker-compose.yml, n8n is published on host port 5680 (5678 is n8n's own
# default and collides with any other n8n already running on the machine), so a host-run agent
# uses http://127.0.0.1:5680/webhook/growpilot-lead. The container itself must NOT use that URL
# — inside it, 127.0.0.1 is its own loopback — so compose reads CONTAINER_N8N_WEBHOOK_URL and
# defaults to the service name http://n8n:5678/webhook/growpilot-lead.
N8N_WEBHOOK_URL="http://127.0.0.1:5680/webhook/growpilot-lead"
# CONTAINER_N8N_WEBHOOK_URL="http://n8n:5678/webhook/growpilot-lead"

# Optional HTTP Basic auth applied to the outbound webhook call. These are the
# credentials configured on the n8n Webhook node (not the n8n owner login).
N8N_USER=""
N8N_PASSWORD=""
# Optional HMAC signing for webhook consumers. n8n can verify
# X-GrowPilot-Signature: sha256=<hex digest>.
N8N_WEBHOOK_SECRET=""
N8N_MAX_ATTEMPTS="3"

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000

# API protection. Set one strong random value in the backend deployment and the same
# value as VITE_GROWPILOT_API_KEY in the frontend build environment. When set, all
# API routes and the live WebSocket require it. Leave unset only for local demos.
GROWPILOT_API_KEY=""
VITE_GROWPILOT_API_KEY=""
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"

# APP_URL: The URL where the app is hosted.
APP_URL="https://abukawser.xyz"

# Where CRM bookings, FAQ rules and GTM records are persisted between restarts.
# Defaults to ./.data/growpilot-state.json (gitignored). Point at a volume in Docker.
# GROWPILOT_STATE_FILE="/var/lib/growpilot/state.json"

# Optional free-tier durable infrastructure. Leave empty for the local JSON/process-local
# fallback. Supabase needs a `growpilot_state` table with tenant_id (primary key), state (jsonb),
# and updated_at (timestamptz). Upstash uses its REST URL/token, which works from Vercel.
SUPABASE_URL=""
# Prefer the new sb_secret_... key. SUPABASE_SERVICE_ROLE_KEY remains supported for legacy projects.
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STATE_TABLE="growpilot_state"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# W3C trace context is emitted on every response and structured http_span logs are written
# to stdout. Set this when you later attach an OTLP collector; the app remains collector-free.
OTEL_SERVICE_NAME="growpilot"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# CLOUDFLARE_TUNNEL_TOKEN: a note to yourself, not a runtime input — no code reads it. The
# systemd unit reads /etc/cloudflared/token (written by `cloudflared service install <token>`).
# Two things to check before installing: the zone's nameservers must be Cloudflare's
# (`dig +short NS yourdomain.xyz`), or the tunnel hostname will never receive public traffic;
# and the token must be alive (`timeout 20 cloudflared --no-autoupdate tunnel run --token '<T>'`
# should log "Registered with connection", not "Invalid tunnel secret").
# Never commit a real token — this file is public.
CLOUDFLARE_TUNNEL_TOKEN=""

# ALLOWED_ORIGINS: comma-separated browser origins allowed to call /api/* cross-origin, e.g.
# the two Vercel subdomains that host the UI. In production, set this explicitly alongside
# GROWPILOT_API_KEY; localhost is allowed automatically only when auth is disabled.
ALLOWED_ORIGINS=""

# VITE_BACKEND_URL: build-time default for the UI when it is hosted somewhere that cannot run
# /api/* or /live (Vercel serves files only, so POST /api/agent/chat answers with index.html).
# Set it in the Vercel project's Environment Variables, not only here, because it is inlined
# into the bundle at build time. A visitor can still override it per browser from the header's
# "Backend:" control, which stores growpilot.backendOrigin in localStorage.
VITE_BACKEND_URL=""
